# Copy to .env and fill in. Never commit .env.

# Required for anything that calls the model (run_questionnaire, run_evals, rewordings propose).
ANTHROPIC_API_KEY=

# Model used by the classifier, drafter, and verifier.
RFP_AGENT_MODEL=claude-sonnet-5

# Replay identical model calls from .cache/llm/ (1 = on). Keeps re-runs free and repeatable.
# Set to 0 after changing documents if you want every call to hit the API again.
LLM_CACHE=1
