# Copy to .env and fill in. Never commit .env.

# Anthropic API key used by the drafter, verifier and classifier agents (Phase 1+)
ANTHROPIC_API_KEY=

# Model used for drafting and verification
RFP_AGENT_MODEL=claude-opus-5-5

# Knowledge base location (manifest + PDFs). Only documents with
# approval_status: approved in the manifest are ever searchable.
KB_DIR=data/sample/kb

# Retrieval: minimum reranked score before the agent must abstain
# with "Insufficient evidence". Tuned against evals/golden_set.yaml.
RETRIEVAL_MIN_SCORE=0.35

# Vector store persistence directory (Phase 1+)
VECTOR_DB_DIR=.vectordb
